#!/bin/env bash
set -euo pipefail

# Get directory of script itself
SOURCE="${BASH_SOURCE[0]}"
# resolve $SOURCE until the file is no longer a symlink
while [ -h "$SOURCE" ]; do
    DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
    SOURCE="$(readlink "$SOURCE")"
    # if $SOURCE was a relative symlink, we need to resolve it relative to the
    # path where the symlink file was located
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"

PROJECT_ROOT="$DIR/../../.."
source "$PROJECT_ROOT/common/setup.sh"
TAG=ror_linux_buildroot
BUILD_DIR="$PROJECT_ROOT/linux/BUILD"

mkdir -p $BUILD_DIR

# Build Linux buildroot
$CONTAINER_PROGRAM build -t $TAG "$DIR"
$CONTAINER_PROGRAM run \
    --rm \
    $CONTAINER_PROGRAM_FLAGS \
    $1 \
    -v "$PROJECT_ROOT/linux/buildroot:/app/buildroot:Z" \
    -v "$BUILD_DIR:/app/output:Z" \
    -v "$PROJECT_ROOT/linux/files:/app/files:Z" \
    -v "$PROJECT_ROOT/linux/bootcode:/app/bootcode:Z" \
    $TAG \
    bash -c "$2"
